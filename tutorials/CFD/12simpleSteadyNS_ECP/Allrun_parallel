#!/bin/sh
# Serial global training followed by an MPI online solve on a fresh case.
set -eu
cd "$(dirname "$0")"
: "${LIB_ITHACA_SRC:?Source ITHACA-FV/etc/bashrc first}"
: "${FOAM_USER_APPBIN:?Source the OpenFOAM environment first}"
ranks=${1:-4}
wmake libso "$LIB_ITHACA_SRC/ITHACA_CORE"
wmake libso "$LIB_ITHACA_SRC/ITHACA_ROMPROBLEMS"
wmake
"$FOAM_USER_APPBIN/12simpleSteadyNS_ECP" -ecpPrepare > log.ecpPrepare 2>&1
parallel_case=$(python3 ./prepare_parallel.py --ranks "$ranks")
printf 'Parallel case: %s\n' "$parallel_case"
cd "$parallel_case"
decomposePar -time 0 > log.decomposePar 2>&1
exec mpirun -np "$ranks" "$FOAM_USER_APPBIN/12simpleSteadyNS_ECP" -parallel

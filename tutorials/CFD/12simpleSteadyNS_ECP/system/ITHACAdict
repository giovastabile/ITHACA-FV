// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          ITHACAdict;
}

EigenSolver     eigen;

NmodesUout      15;

NmodesUproj     5;

NmodesPout      15;

NmodesPproj     5;

NmodesSUPout    15;

NmodesSUPproj   15;

OutPrecision    20;

OutType         fixed;

tolerance       1e-05;

residualJumpLim 1e-05;

normalizedResidualLim 1e-05;

maxIterOn       3000;

debug           true;

online_velocities vel.txt;

middleExport    true;

ecpNodes        100;

ecpLayers       8;

ecpTrainingSnapshots 2;

hrEquivalenceTests true;

ecpValidate     true;

ecpValidationTolerance 0.05;

ecpTolerance    1e-08;

ecpBasisTolerance 1e-06;


// ************************************************************************* //

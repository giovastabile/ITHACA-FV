FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      ITHACAdict;
}

// EigenValue solver, can be eigen or spectra
EigenSolver eigen;

// Number of modes to output and to use for projection
NmodesUout 15;
NmodesUproj 10;
NmodePUout 15;
NmodesPproj 10;
NmodesSUPout 15;
NmodesSUPproj 10;

// Output format to save market vectors.
OutPrecision 20;
OutType fixed;

// Specific problem of a stationary case
tolerance 1e-5;

// Reduced simple cicle parameters
residualJumpLim 1e-5;
normalizedResidualLim 1e-5;
maxIterOn 1000;
debug                   true;

// Inlet boundary conditions velocities.
online_velocities vel.txt;

// Do not export middle fields for this case
middleExport false;

// Hyper-reduced SIMPLE
// Residual sample cells are read from constant/polyMesh/sets/hrSamples
// (or processor*/constant/polyMesh/sets/hrSamples after decomposition).
// hrSampleSet hrSamples;

// Add these entries to system/ITHACAdict



// Fraction used by residual-based greedy sampling before boundary cells
// are added.


// Exclude immediate face-neighbours from subsequent greedy picks.
// Use 0 for no spacing. Current implementation supports >0 in serial.


// Halo used to assemble finite-volume stencils around sampled cells.
hrLayers             2;

// Parameter column used for the full-ROM training solve.
hrTrainingParameter  0;

// Used only when useResidualSampling=false.
// hrSampleSet          hrSamples;
hrCompareFullSampled true;

// Keep the existing equivalence diagnostics on
hrEquivalenceTests true;
hrTestMode 0;

// Sparse test
useResidualSampling true;
hrSampleFraction 0.5;
hrSpacingLayers 1;
hrLayers 2;


